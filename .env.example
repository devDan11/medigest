# --- Base de datos ---
DB_HOST=localhost
DB_PORT=1433
DB_NAME=MediGestDB
DB_USERNAME=medigest_app
DB_PASSWORD=CAMBIAR_Clave_Segura_123
DB_ENCRYPT=true
# true solo en local/dev con certificados autofirmados. En producción debe ser false.
DB_TRUST_SERVER_CERTIFICATE=true

# --- Solo para docker-compose (usuario administrador del contenedor) ---
MSSQL_SA_PASSWORD=CAMBIAR_Sa_Clave_Fuerte_123

# --- Datos de demostración (solo con el perfil demo) ---
# Contraseña de TODAS las cuentas ficticias (admin@medigest.test, medico1@medigest.test, ...).
# Elija una propia; no la reutilice en otros sitios. Nunca suba el .env a GitHub.
DEMO_PASSWORD=CAMBIAR_Clave_Demo_123

# --- Seguridad ---
# Clave de firma de los tokens JWT (mínimo 32 caracteres). Genere una con:  openssl rand -base64 48
# En dev, si falta, se usa una clave efímera (los tokens dejan de valer al reiniciar). En prod es obligatoria.
JWT_SECRET=CAMBIAR_por_una_clave_larga_y_aleatoria
