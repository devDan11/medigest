              "path": [
                "api",
                "v1",
                "auth",
                "cambiar-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passwordActual\": \"{{password}}\",\n  \"nuevaPassword\": \"Nueva-Clave-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
