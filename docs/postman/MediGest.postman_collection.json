                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Ana\",\n  \"apellidos\": \"Prueba Postman\",\n  \"tipoDocumento\": \"DNI\",\n  \"numeroDocumento\": \"70123456\",\n  \"fechaNacimiento\": \"1990-05-20\",\n  \"sexo\": \"F\",\n  \"email\": \"ana.postman@medigest.test\",\n  \"telefono\": \"999888777\",\n  \"password\": \"Cambiar-Clave-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
